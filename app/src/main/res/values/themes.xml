<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wechat_action</item>
        <item name="colorPrimaryVariant">@color/wechat_green_dark</item>
        <item name="colorOnPrimary">@color/wechat_on_action</item>
        <item name="colorSecondary">@color/wechat_action</item>
        <item name="colorSecondaryVariant">@color/wechat_green_dark</item>
        <item name="colorOnSecondary">@color/wechat_on_action</item>

        <item name="colorControlHighlight">@color/theme_focused_touch</item>
        <item name="colorControlNormal">@color/wechat_text_secondary</item>
        <item name="colorControlActivated">@color/wechat_green</item>

        <item name="colorPrimaryDark">@color/wechat_green_dark</item>
        <item name="android:statusBarColor">@color/wechat_bg</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:colorBackground">@color/wechat_bg</item>
        <item name="android:windowBackground">@color/wechat_bg</item>
        <item name="android:textColorPrimary">@color/wechat_text_primary</item>
        <item name="android:textColorSecondary">@color/wechat_text_secondary</item>
        <item name="colorSurface">@color/wechat_surface</item>
        <item name="colorOnSurface">@color/wechat_text_primary</item>
        <item name="colorOnBackground">@color/wechat_text_primary</item>
        <item name="android:navigationBarColor">@color/wechat_nav_bg</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="cardViewStyle">@style/Portal.CardView</item>
        <item name="materialCardViewStyle">@style/Portal.MaterialCardView</item>
        <item name="floatingActionButtonStyle">@style/Portal.FloatingActionButton</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:textColorHint">@color/wechat_text_hint</item>
        <item name="android:editTextColor">@color/wechat_text_primary</item>
        <item name="searchViewStyle">@style/Portal.SearchViewStyle</item>
        <item name="selectableItemBackgroundBorderless">@drawable/ripple_effect</item>
        <item name="sliderStyle">@style/Portal.SliderTheme</item>
    </style>

    <style name="Portal.SliderTheme" parent="Widget.MaterialComponents.Slider">

    </style>

    <style name="Portal.SearchViewStyle" parent="Widget.AppCompat.SearchView">
    </style>

    <style name="AppTheme.Portal.ToolBarOverlay" parent="ThemeOverlay.AppCompat.DayNight.ActionBar">
        <item name="colorControlNormal">@color/theme_appbar_icon_color</item>
        <item name="android:textColorPrimary">@color/theme_appbar_text_color</item>
        <item name="android:textColorSecondary">@color/wechat_text_secondary</item>
    </style>

    <style name="AppTheme.Portal.PopupTheme" parent="ThemeOverlay.AppCompat.DayNight">

    </style>

    <style name="AppTheme.Dark" parent="Theme.AppCompat.NoActionBar">
        <item name="colorAccent">@color/accent</item>
        <!--<item name="colorAccentFallback">@color/accentFallback</item>-->
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!--<item name="cardStyle">@style/CardViewStyle.Dark</item>-->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:textColorSecondary">@color/dark_secondary_text</item>
        <!--<item name="imageColorTint">@color/dark_secondary_text</item>-->
    </style>

    <style name="AppTheme.Translucent" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
    </style>

    <style name="AppTheme.Dialog" parent="ThemeOverlay.AppCompat.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:background">@android:color/transparent</item>

        <!--<item name="dialog_positive_color">@color/tx_appbar_color</item>
        <item name="dialog_negative_color">@color/red500</item>
        <item name="dialog_neutral_color">@color/tx_appbar_color</item>-->
    </style>

    <style name="AppTheme.MaterialButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/wechat_on_action</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:gravity">center</item>
        <item name="backgroundTintMode">src_atop</item>
        <item name="elevation">10dp</item>
        <item name="rippleColor">@color/white</item>
        <item name="iconTintMode">src_atop</item>
        <item name="iconTint">@color/wechat_on_action</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
    </style>

    <style name="CardViewStyle.Dark" parent="CardView">
        <item name="cardBackgroundColor">@android:color/background_dark</item>
    </style>

    <style name="CardViewStyle.Light" parent="CardView">
        <item name="cardBackgroundColor">@android:color/background_light</item>
    </style>

    <style name="AppTheme.StatusBar" parent="AppTheme">
        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
    </style>

    <style name="AppTheme.StatusBar.Dark" parent="AppTheme.Dark">
        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
    </style>
    <style name="Portal.CardView" parent="CardView">
        <item name="cardBackgroundColor">@color/wechat_surface</item>
    </style>

    <style name="Portal.MaterialCardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/wechat_surface</item>
    </style>

    <style name="Portal.FloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/wechat_action</item>
        <item name="tint">@color/wechat_on_action</item>
    </style>
</resources>