<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.mock.MockFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/mock_location_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="4dp"
            android:layout_margin="8dp"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/portal_mini_title_color"
                    android:textAppearance="@style/TextAppearance.AppCompat.Inverse"
                    android:text="@string/target_route"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/mock_route_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/none_route"
                        android:textAppearance="@style/TextAppearance.AppCompat.Title"
                        android:textColor="@color/wechat_text_primary"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/switch_mock"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:textColor="@color/wechat_on_action"
                            android:text="@string/start_mock"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:insetRight="0dp"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:textSize="12sp"
                            app:icon="@drawable/rounded_play_arrow_24"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            android:padding="6dp"
                            app:iconTint="@color/wechat_on_action"
                            app:cornerRadius="12dp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:gravity="end|center">

                        <CheckedTextView
                            android:id="@+id/rocker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checkMark="?android:attr/listChoiceIndicatorMultiple"
                            android:checkMarkTint="@color/portal_mock_off"
                            android:checked="false"
                            android:gravity="center"
                            android:text="@string/rocker"
                            android:textColor="@color/portal_mock_off"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/route_pace_title"
                            android:textSize="14sp"
                            android:textColor="@color/portal_mini_title_color" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/route_pace_value"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:textAllCaps="false"
                            android:textSize="16sp"
                            android:textColor="@color/wechat_text_primary" />
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/route_pace_slider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/route_pace_title"
                        android:stepSize="1"
                        android:valueFrom="20"
                        android:valueTo="2000"
                        android:value="300"
                        app:tickVisible="false"
                        app:thumbElevation="2dp"
                        app:trackHeight="4dp" />

                    <TextView
                        android:id="@+id/route_pace_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/route_pace_hint"
                        android:textSize="12sp"
                        android:textColor="@color/wechat_text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/route_steps_switch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="@string/route_steps_title"
                        android:textColor="@color/wechat_text_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/route_stride_value"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:textColor="@color/wechat_text_primary"
                        android:textAllCaps="false" />
                </LinearLayout>

                <TextView
                    android:id="@+id/route_cadence_preview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/wechat_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/route_steps_hint"
                    android:textSize="12sp"
                    android:textColor="@color/wechat_text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/runtime_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/runtime_phase_idle"
                        android:textSize="12sp"
                        android:textColor="@color/wechat_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/runtime_diagnostics"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="64dp"
                        android:minHeight="48dp"
                        android:text="@string/runtime_diagnostic_action"
                        android:textColor="@color/wechat_text_primary" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.AppCompat.Inverse"
                android:textColor="@color/portal_mini_title_color"
                android:text="@string/history_route" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/route_import"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:minHeight="48dp"
                android:text="@string/route_import"
                android:textColor="@color/wechat_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/route_export"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:minHeight="48dp"
                android:text="@string/route_export"
                android:textColor="@color/wechat_text_primary" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:text="@string/route_transfer_hint"
            android:textSize="12sp"
            android:textColor="@color/wechat_text_secondary" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/route_transfer_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:indeterminate="true"
            android:contentDescription="@string/route_transfer_working"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="8dp"
            app:cardCornerRadius="6dp"
            app:cardPreventCornerOverlap="false"
            app:contentPadding="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/historical_route_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_mock_location"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fab_margin"
        android:layout_marginEnd="@dimen/fab_margin"
        android:contentDescription="@string/follow_location"
        app:srcCompat="@drawable/sharp_location_off_24"
        android:backgroundTint="@color/wechat_green"
        android:tint="@color/wechat_on_action"
        app:fabSize="auto"
        android:visibility="gone"
        android:layout_gravity="bottom|end"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start">
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fab_margin"
            android:layout_marginBottom="@dimen/fab_margin"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/baseline_keyboard_arrow_up_24"
            app:fabSize="normal"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_add_route"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fab_margin"
                android:contentDescription="@string/add_route"
                android:visibility="gone"
                app:srcCompat="@drawable/baseline_route_24"
                app:fabSize="mini"/>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
